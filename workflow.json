      "parameters": {
        "jsCode": "// \u270f\ufe0f EDIT THIS LIST to add/remove niches\n// One niche name per entry \u2014 the pipeline runs once per niche\nconst niches = [\n  'fitness',\n  'gen-z',\n  'nurse',\n  'christian',\n  'cat-lovers',\n];\n\nreturn niches.map(niche => ({ json: { niche } }));"
