      "id": "reddit-prefetch",
      "name": "Reddit Pre-fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json?.organic_results || [];\nconst niche = $('Read Niches').first().json.niche;\nconst design_style = $('Read Niches').first().json.design_style || '';\n\n// Extract Reddit post titles + snippets as marketing context\nconst redditPosts = results\n  .filter(r => r.link && r.link.includes('reddit.com'))\n  .slice(0, 8)\n  .map(r => r.title + ' \u2014 ' + (r.snippet || ''));\n\n// Build marketing_pages from subreddit links found\nconst subreddits = [...new Set(\n  results\n    .map(r => r.link?.match(/reddit\\.com\\/(r\\/[a-zA-Z0-9_]+)/)?.[1])\n    .filter(Boolean)\n)].slice(0, 5).join(',');\n\nreturn [{\n  json: {\n    niche,\n    design_style,\n    marketing_pages: subreddits || `r/${niche}`,\n    reddit_context:  redditPosts.join('\\n'),\n  }\n}];"
      },
      "id": "parse-reddit-context",
      "name": "Parse Reddit Context",
      "type": "n8n-nodes-base.code",
