    {
      "id": "style-search",
      "name": "Research Design Style",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://serpapi.com/search.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "engine",
              "value": "google_shopping"
            },
            {
              "name": "q",
              "value": "={{ $json.niche + ' t-shirt bestseller' }}"
            },
            {
              "name": "api_key",
              "value": "={{ $env.SERPAPI_KEY }}"
            },
            {
              "name": "gl",
              "value": "us"
            },
            {
              "name": "hl",
              "value": "en"
            },
            {
              "name": "num",
              "value": "10"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "analyze-style",
      "name": "Analyze Design Style",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'llama-3.1-8b-instant',\n  messages: [{\n    role: 'user',\n    content: 'You are a POD design strategist. Based on these REAL bestselling t-shirt titles for the \"'\n           + $('Read Niches').first().json.niche\n           + '\" niche:\\n\\n'\n           + ($json?.shopping_results || []).slice(0,8).map(r => '- ' + r.title).join('\\n')\n           + '\\n\\nDescribe the dominant design style in ONE sentence (max 20 words).'\n           + ' Focus on: phrase patterns, tone, typography, graphics.'\n           + ' Return ONLY the style description, nothing else.'\n  }],\n  max_tokens: 60,\n  temperature: 0.3\n}) }}"
      }
    },
    {
      "id": "parse-niche-style",
      "name": "Parse Niche Style",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "jsCode": "const niche = $('Read Niches').first().json.niche;\nconst raw = $input.first().json?.choices?.[0]?.message?.content || '';\nconst design_style = raw.trim() || 'bold two-word phrases, minimalist graphic, clean urban typography';\nreturn [{ json: {\n  niche,\n  design_style,\n  marketing_pages: 'r/' + niche.replace(/[^a-zA-Z0-9]/g, '')\n} }];"
      }
    }
