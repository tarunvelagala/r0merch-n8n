      "parameters": {
        "jsCode": "// Read niches from /niches.csv (mounted from project root)\n// Add/remove rows in niches.csv to change what the pipeline processes\n// Format: one niche per line (header row: niche)\nconst fs = require('fs');\n\nlet lines = [];\ntry {\n  const raw = fs.readFileSync('/niches.csv', 'utf8');\n  lines = raw.split('\\n')\n    .map(l => l.trim())\n    .filter(l => l && l.toLowerCase() !== 'niche');\n} catch(e) {\n  // Fallback if file not found\n  lines = ['fitness', 'nurse', 'cat-lovers'];\n}\n\n// Design style lookup \u2014 edit here to customise per niche\n// If niche not listed here, a default style is used\nconst styleMap = {\n  'fitness':    'motivational two-word phrases, bold single word, gym slang, emoji + word combos like \ud83d\udcaaGRIND',\n  'gen-z':      'ironic one-liners, emoji combos \ud83d\udc80\u2728, internet slang, two-word absurdist phrases, lowercase aesthetic',\n  'anime':      'japanese kanji + english mix, character silhouettes, one word in bold katakana',\n  'christian':  'faith-based two-word phrases, cross + word combos, bible verse typography',\n  'nurse':      'humor + profession combos, two-word slogans, emoji + role like \ud83d\udc89NURSE, sarcastic one-liners',\n  'cat-lovers': 'cute emoji combos \ud83d\udc31, one-word cat puns, ironic cat phrases, minimalist cat silhouette + word',\n  'dog-lovers': 'dog puns, pawsitive vibes, playful one-liners, bold + cute',\n  'teacher':    'sarcastic teacher humor, two-word phrases, pencil/apple motifs, bold serif',\n  'veteran':    'patriotic bold phrases, military symbols, honor + duty typography',\n  'mom':        'mom humor, coffee + chaos, two-word relatable phrases, soft bold',\n  'dad':        'dad joke one-liners, two-word groan phrases, minimal graphic + word',\n};\n\nconst defaultStyle = 'bold two-word phrases, minimalist graphic, clean typography, urban aesthetic';\n\nreturn lines.map(niche => ({\n  json: {\n    niche,\n    design_style: styleMap[niche.toLowerCase()] || defaultStyle,\n    marketing_pages: `r/${niche.replace(/[^a-zA-Z0-9]/g, '')}`\n  }\n}));"
      },
