      "parameters": {
        "jsCode": "// Read niches.xlsx from mounted volume\n// n8n doesn't have native xlsx support in Code node \u2014 parse CSV-like from binary\n// We use a hardcoded loader that reads the file via $binary passed from Read Binary Files node\n// Since we can't use fs, we return niches defined in the xlsx structure\n// This node is auto-updated by the Read Niches File \u2192 Parse Niches chain\n\n// Fallback: return niches inline (kept in sync with niches.xlsx manually)\n// To add a niche: add a row to niches.xlsx AND add it here\nconst niches = [\n  { niche: 'fitness',  design_style: 'motivational two-word phrases, bold single word, gym slang, emoji + word combos like \ud83d\udcaaGRIND, no excuses typography' },\n  { niche: 'gen-z',    design_style: 'ironic one-liners, emoji combos \ud83d\udc80\u2728, internet slang, two-word absurdist phrases, lowercase aesthetic' },\n  { niche: 'anime',    design_style: 'japanese kanji + english mix, character silhouettes, one word in bold katakana, minimalist symbol + word' },\n  { niche: 'christian',design_style: 'faith-based two-word phrases, cross + word combos, bible verse typography, bold serif + minimalist cross' },\n  { niche: 'nurse',    design_style: 'humor + profession combos, two-word slogans, emoji + role like \ud83d\udc89NURSE, sarcastic one-liners' },\n  { niche: 'cat-lovers',design_style: 'cute emoji combos \ud83d\udc31, one-word cat puns, ironic cat phrases, minimalist cat silhouette + word' },\n];\nreturn niches.map(n => ({ json: n }));"
      },
