    "name": "POD Artwork Generator Agent",
    "description": null,
    "active": false,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "jsCode": "  const niche = $('Execute Workflow Trigger').first().json.niche;\n  const raw = $('Artwork Search').first()?.json || {};\n  const results = raw?.organic || raw?.organic_results || [];\n\n  const docs = results.map(r =>\n    ((r.title || '') + ' ' + (r.snippet || '')).toLowerCase()\n    .split(/[\\s\\-\\/,.|&()+]+/)\n    .filter(w => w.length > 3 && /^[a-z]+$/.test(w))\n  );\n\n  const tf = {}, df = {};\n  docs.forEach(words => {\n    const seen = new Set();\n    words.forEach(w => {\n      tf[w] = (tf[w] || 0) + 1;\n      if (!seen.has(w)) { df[w] = (df[w] || 0) + 1; seen.add(w); }\n    });\n  });\n\n  const n = docs.length || 1;\n  const topWords = Object.entries(tf)\n    .filter(([w]) => df[w] >= 2 && df[w] / n < 0.8)\n    .map(([w, count]) => ({ w, score: count * Math.log(n / df[w]) }))\n    .sort((a, b) => b.score - a.score)\n    .slice(0, 30)\n    .map(e => e.w);\n\n  const inspirationSeeds = results\n    .map(r => r.title || '')\n    .filter(Boolean)\n    .map(t => t.replace(/\\|.*$/, '').trim())\n    .filter(t => t.length > 3 && t.length < 60)\n    .slice(0, 12);\n\n  return [{ json: { niche, data: { topArtworkTerms: topWords, inspirationSeeds, totalResults: results.length } } }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                48,
                -16
            ],
            "id": "f33a5704-c905-4231-8cd7-8a65d12e1caf",
            "name": "Parse Artwork Signals"
        },
        {
            "parameters": {
                "errorMessage": "Error Occurred - POD Stickers Generator"
            },
            "type": "n8n-nodes-base.stopAndError",
            "typeVersion": 1,
            "position": [
                496,
                160
            ],
            "id": "54ebff76-fe07-4688-9c2c-21f9be42a686",
            "name": "Stop and Error"
        },
        {
            "parameters": {
                "jsCode": "  const raw = $input.first().json?.choices?.[0]?.message?.content || '{}';\nconst niche = $('Execute Workflow Trigger').first().json.niche;\n  const clean = raw.replace(/```json|```/g, '').trim();\n  let artwork = {};\n  try { artwork = JSON.parse(clean); } catch(_) {}\n  \n  return [{ json: {\n    niche,\n    artwork: {\n      illustrationStyle: artwork.illustrationStyle || '',\n      colorMood:         artwork.colorMood         || '',\n      composition:       artwork.composition        || '',\n      iconThemes:        artwork.iconThemes         || [],\n      artworkNotes:      artwork.artworkNotes       || '',\n      topTerms:          $('Parse Artwork Signals').first().json.data?.topArtworkTerms || [],\n      totalResults:      $('Parse Artwork Signals').first().json.data?.totalResults    || 0,\n    }\n  } }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                496,
                -64
            ],
            "id": "0fb8c807-999b-4fc2-a292-a1eaeb429381",
