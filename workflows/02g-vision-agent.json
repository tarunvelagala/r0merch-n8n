  "id": "b7a2e73f-4388-431e-9bb3-737dfd7cf77d",
  "name": "r0merch \u2014 Vision Agent",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst niche = input.niche || '';\nconst etsyImages   = (input.etsy   || []).map(i => i.image).filter(Boolean);\nconst amazonImages = (input.amazon || []).map(i => i.image).filter(Boolean);\nconst imageUrls = [...new Set([...etsyImages, ...amazonImages])].slice(0, 8);\n\nif (imageUrls.length === 0) {\n  return [{ json: { source: 'vision', niche, data: [], skipped: true } }];\n}\nreturn imageUrls.map((url, index) => ({ json: { niche, imageUrl: url, index, skipped: false } }));"
      },
      "id": "prepare-images",
      "name": "Prepare Image List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skipped }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-skipped",
      "name": "Has Images?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.imageUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 15000
        }
      },
      "id": "download-image",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst ctx  = $('Prepare Image List').first().json;\nconst binaryKey = Object.keys(item.binary || {})[0] || 'data';\nconst binary = item.binary?.[binaryKey];\nif (!binary?.data) throw new Error('Failed to download image: ' + ctx.imageUrl);\nreturn [{ json: { niche: ctx.niche, imageUrl: ctx.imageUrl, index: ctx.index, base64: binary.data, mimeType: binary.mimeType || 'image/jpeg' } }];"
      },
      "id": "encode-image",
      "name": "Encode to Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        150
      ]
    },
    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ inline_data: { mime_type: $json.mimeType, data: $json.base64 } }, { text: 'Analyze this t-shirt design image. Return ONLY a raw JSON object, no markdown.\\n{\\n  \"style\": \"\",\\n  \"layout\": \"\",\\n  \"colors\": [],\\n  \"fonts\": \"\",\\n  \"icons\": [],\\n  \"texture\": \"\",\\n  \"complexity\": \"\",\\n  \"visualHierarchy\": \"\",\\n  \"mood\": \"\"\\n}' }] }], generationConfig: { temperature: 0.1, maxOutputTokens: 512 } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "gemini-vision",
      "name": "Gemini Vision Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        150
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst niche = $('Execute Workflow Trigger').first().json.niche || '';\nconst data = items.map((item, i) => {\n  const raw = item.json?.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  const clean = raw.replace(/```json|```/g, '').trim();\n  const match = clean.match(/\\{[\\s\\S]*\\}/);\n  let analysis = {};\n  try { analysis = JSON.parse(match?.[0] || '{}'); } catch (_) {}\n  return { imageIndex: i, ...analysis };\n}).filter(a => a.style || a.layout);\nreturn [{ json: { source: 'vision', niche, data } }];"
      },
      "id": "parse-vision",
      "name": "Parse Vision Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        450
      ]
    }
  ],
  "connections": {
