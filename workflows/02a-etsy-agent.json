      "id": "etsy-organic-fetch",
      "name": "SerpAPI Etsy Organic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst shoppingRaw = $('SerpAPI Etsy Shopping').first().json;\nconst organicRaw  = $('SerpAPI Etsy Organic').first().json;\n\n// Shopping results — have price, image, rating\nconst shopping = (shoppingRaw?.shopping_results || []).map(r => ({\n  title:    r.title   || '',\n  url:      r.link    || '',\n  price:    r.price   || '',\n  image:    r.thumbnail || '',\n  rating:   r.rating  || 0,\n  reviews:  r.reviews || 0,\n  tags:     [],\n  source:   'google_shopping'\n}));\n\n// Organic results — extract tags from title keywords\nconst organic = (organicRaw?.organic_results || [])\n  .filter(r => r.link?.includes('etsy.com'))\n  .map(r => ({\n    title:    r.title   || '',\n    url:      r.link    || '',\n    price:    '',\n    image:    r.thumbnail || '',\n    rating:   0,\n    reviews:  0,\n    tags:     (r.title || '').toLowerCase().split(/[\\s,|–-]+/).filter(t => t.length > 3),\n    source:   'google_organic'\n  }));\n\nconst data = [...shopping, ...organic].slice(0, 30);\n\nreturn [{ json: { source: 'etsy', niche, data } }];"
      },
      "id": "parse-etsy",
      "name": "Parse Etsy Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    }
