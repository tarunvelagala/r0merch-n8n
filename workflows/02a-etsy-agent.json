  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://openapi.etsy.com/v3/application/listings/active",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "keywords",
              "value": "={{ $json.niche + ' t-shirt' }}"
            },
            {
              "name": "limit",
              "value": "25"
            },
            {
              "name": "sort_on",
              "value": "score"
            },
            {
              "name": "sort_order",
              "value": "desc"
            },
            {
              "name": "includes",
              "value": "Images,Tags"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.ETSY_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "etsy-fetch",
      "name": "Etsy API Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst results = $input.first().json?.results || [];\n\nconst data = results.map(listing => ({\n  title:       listing.title || '',\n  url:         `https://www.etsy.com/listing/${listing.listing_id}`,\n  price:       listing.price\n               ? `${(listing.price.amount / listing.price.divisor).toFixed(2)} ${listing.price.currency_code}`\n               : '',\n  image:       listing.Images?.[0]?.url_570xN || '',\n  tags:        listing.tags || [],\n  description: (listing.description || '').slice(0, 300),\n  views:       listing.views || 0,\n  favCount:    listing.num_favorers || 0\n}));\n\nreturn [{ json: { source: 'etsy', niche, data } }];"
      },
      "id": "parse-etsy",
      "name": "Parse Etsy Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    }
  ],
