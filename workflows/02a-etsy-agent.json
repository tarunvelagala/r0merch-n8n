    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst raw = (() => { try { return $('Etsy via Google').first()?.json || {}; } catch(_) { return {}; } })();\nconst results = (raw?.organic_results || []).filter(r => r.link?.includes('etsy.com'));\nconst data = results.map(r => ({\n  title:   r.title   || '',\n  url:     r.link    || '',\n  price:   '',\n  image:   r.thumbnail || '',\n  rating:  0,\n  reviews: 0,\n  tags:    (r.title || '').toLowerCase().split(/[\\s,|]+/).filter(t => t.length > 3),\n  snippet: r.snippet || ''\n}));\nreturn [{ json: { source: 'etsy', niche, data } }];"
      },
