  "name": "r0merch \u2014 Keyword Generator",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all()[0]?.json || {};\nconst category = input.category || input.niche || 'streetwear';\nreturn [{ json: { category } }];"
      },
      "id": "unpack",
      "name": "Unpack Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"llama-3.1-8b-instant\", messages: [{ role: \"user\", content: \"You are a POD market analyst for r0merch. For the \\\"\" + $json.category + \"\\\" niche, identify the SINGLE best print-on-demand t-shirt keyword right now. Criteria: high search demand, low competition, emotionally resonant, 1-3 words max, visually printable, trending on Etsy/Amazon.\\n\\nExamples: fitness=GRIND MODE, nurse=SAVING LIVES, cat-lovers=CAT MOM\\n\\nReturn ONLY the keyword, nothing else. No quotes, no explanation.\" }], max_tokens: 20, temperature: 0.5 }) }}"
      },
      "id": "groq-keywords",
      "name": "Groq Keyword Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const category = $('Unpack Input').first().json.category;\nconst raw = $input.first().json?.choices?.[0]?.message?.content || '';\nconst keyword = raw.trim().replace(/[\"']/g, '').toUpperCase();\nreturn [{ json: { category, keyword, keywords: [keyword] } }];"
      },
      "id": "parse-keywords",
      "name": "Parse Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    }
  ],
  "connections": {
