      "id": "google-niche-fetch",
      "name": "SerpAPI Niche Ideas Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst mainRaw  = $('SerpAPI Google Search').first()?.json || {};\nconst nicheRaw = (() => { try { return $('SerpAPI Niche Ideas Search').first()?.json || {}; } catch(_) { return {}; } })();\nconst m = r => ({title:r.title||'',url:r.link||'',snippet:r.snippet||''});\nconst organic = (mainRaw?.items||[]).map(m);\nconst relatedSearches = [...((mainRaw?.queries?.request || [])||[]).map(s=>s.query),...(nicheRaw?.related_searches||[]).map(s=>s.query)].filter(Boolean);\nconst peopleAlsoAsk = ([]||[]).map(q=>q.question).filter(Boolean);\nreturn [{json:{source:'google_search',niche,data:{organic,relatedSearches,peopleAlsoAsk}}}];"
      },
      "id": "parse-google-search",
      "name": "Parse Google Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
