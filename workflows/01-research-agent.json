    {
      "parameters": {
        "jsCode": "// Collect all parallel branch outputs into one research object\nconst items = $input.all();\nconst niche = $('Unpack Input').first().json.niche;\n\nconst result = {\n  niche,\n  etsy:         items.find(i => i.json.source === 'etsy')?.json?.data        || [],\n  amazon:       items.find(i => i.json.source === 'amazon')?.json?.data      || [],\n  pinterest:    items.find(i => i.json.source === 'pinterest')?.json?.data   || [],\n  reddit:       items.find(i => i.json.source === 'reddit')?.json?.data      || [],\n  googleSearch: items.find(i => i.json.source === 'google_search')?.json?.data || [],\n  googleTrends: items.find(i => i.json.source === 'google_trends')?.json?.data || [],\n  vision:       items.find(i => i.json.source === 'vision')?.json?.data      || [],\n  collectedAt:  new Date().toISOString()\n};\n\nreturn [{ json: result }];"
      },
      "id": "combine-research",
      "name": "Combine Research",
      "type": "n8n-nodes-base.code",
