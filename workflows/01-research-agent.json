    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst niche = $('Unpack Input').first().json.niche || '';\n\n// Each item is either a direct source object or wrapped\nconst find = (source) => {\n  const item = items.find(i => {\n    const j = i.json;\n    return j.source === source || (j[source] !== undefined);\n  });\n  if (!item) return source === 'twitter' ? {} : [];\n  const j = item.json;\n  if (j.source === source) return j.data || (source === 'twitter' ? {} : []);\n  return j[source] || (source === 'twitter' ? {} : []);\n};\n\nconst result = {\n  niche,\n  etsy:         find('etsy'),\n  amazon:       find('amazon'),\n  pinterest:    find('pinterest'),\n  reddit:       find('reddit'),\n  googleSearch: find('google_search'),\n  googleTrends: find('google_trends'),\n  vision:       find('vision'),\n  twitter:      find('twitter'),\n  collectedAt:  new Date().toISOString()\n};\n\nreturn [{ json: result }];"
      },
