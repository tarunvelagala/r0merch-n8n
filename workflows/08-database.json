  "name": "r0merch — Database",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed;\ntry {\n  parsed = typeof raw.records === 'string' ? JSON.parse(raw.records) : raw;\n} catch (_) { parsed = raw; }\n\nconst records = parsed.records || (Array.isArray(parsed) ? parsed : [parsed]);\nreturn records.map(r => ({ json: r }));"
      },
      "id": "split-records",
      "name": "Split Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "resource": "page",
        "operation": "create",
        "databaseId": "={{ $env.NOTION_DATABASE_ID }}",
        "title": "={{ $json.etsyTitle || $json.title }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Niche",
              "type": "rich_text",
              "textValue": "={{ $json.niche }}"
            },
            {
              "key": "Phrase",
              "type": "rich_text",
              "textValue": "={{ $json.phrase }}"
            },
            {
              "key": "Tone",
              "type": "select",
              "selectValue": "={{ $json.tone }}"
            },
            {
              "key": "PNG URL",
              "type": "url",
              "urlValue": "={{ $json.imageUrl }}"
            },
            {
              "key": "Etsy Tags",
              "type": "rich_text",
              "textValue": "={{ ($json.etsyTags || []).join(', ') }}"
            },
            {
              "key": "Created Date",
              "type": "date",
              "dateValue": "={{ $json.generatedAt }}"
            }
          ]
        }
      },
      "id": "save-notion",
      "name": "Save to Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "disabled": true,
      "notes": "Set NOTION_DATABASE_ID in n8n Variables. Enable when ready."
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "={{ $env.AIRTABLE_BASE_ID }}",
        "tableId": "Designs",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Niche": "={{ $json.niche }}",
            "Title": "={{ $json.etsyTitle || $json.title }}",
            "Phrase": "={{ $json.phrase }}",
            "PNG URL": "={{ $json.imageUrl }}",
            "Etsy Tags": "={{ ($json.etsyTags || []).join(', ') }}",
            "Created Date": "={{ $json.generatedAt }}"
          }
        },
        "options": {}
      },
      "id": "save-airtable",
      "name": "Save to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        440,
        450
      ],
      "disabled": true,
      "notes": "Set AIRTABLE_BASE_ID in n8n Variables. Enable when ready."
    },
    {
      "parameters": {
        "jsCode": "const record = $input.first().json;\nconst niche = record.niche || record.etsyTitle || 'design';\nconst ts = new Date().toISOString().replace(/[:.]/g, '-');\nconst fileName = `design_${niche}_${ts}.json`;\nconst content = JSON.stringify(record, null, 2);\n\n// Use $binary to write file via n8n's binary system\nconst binaryData = await this.helpers.prepareBinaryData(\n  Buffer.from(content, 'utf8'),\n  fileName,\n  'application/json'\n);\n\nreturn [{ json: { fileName, saved: true }, binary: { data: binaryData } }];"
      },
      "id": "to-binary",
      "name": "Convert to Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        150
      ]
    },
    {
      "parameters": {
        "fileName": "=/home/node/.n8n-files/={{ $binary.data.fileName }}",
        "dataPropertyName": "data"
      },
      "id": "write-file",
      "name": "Write to File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        660,
        150
      ]
    }
  ],
