    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "method": "POST",
        "jsonBody": "={{ {\n  model: \"llama-3.1-8b-instant\",\n  messages: [{\n    role: \"user\",\n    content: \"You are a POD trend analyst. Research data for niche: \" + ($json.trendReport ? JSON.parse($json.trendReport).niche : ($json.niche || \"\")) + \"\\n\\n\" + (() => { try { return $json.trendReport ? $json.trendReport : JSON.stringify($json); } catch(_) { return \"{}\"; } })() + \"\\n\\nIdentify: 1. Recurring colors (hex) 2. Typography styles 3. Illustrations/icons 4. Layouts 5. Underserved opportunities 6. Saturated ideas 7. Emerging trends 8. Audience segments 9. Seasonality 10. Top 5 design directions.\\n\\nReturn ONLY a JSON object, no markdown:\\n{\\\"recurringColors\\\":[],\\\"typographyStyles\\\":[],\\\"illustrations\\\":[],\\\"layouts\\\":[],\\\"underservedOpportunities\\\":[],\\\"saturatedIdeas\\\":[],\\\"emergingTrends\\\":[],\\\"audienceSegments\\\":[],\\\"seasonality\\\":{},\\\"topDesignDirections\\\":[]}\"\n  }],\n  temperature: 0.4,\n  max_tokens: 2048\n} }}"
      },
      "id": "gemini-analyst",
      "name": "Groq Trend Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json?.choices?.[0]?.message?.content || '{}';\nconst clean = raw.replace(/```json|```/g, '').trim();\nconst match = clean.match(/\\{[\\s\\S]*\\}/);\nlet a = {};\ntry { a = JSON.parse(match?.[0] || '{}'); } catch(_) {}\n\nconst input = $('Execute Workflow Trigger').first().json;\nlet niche = '';\ntry {\n  const report = input.trendReport ? JSON.parse(input.trendReport) : input;\n  niche = report.niche || '';\n} catch(_) { niche = input.niche || ''; }\n\nreturn [{ json: { niche, ...a } }];"
      },
      "id": "parse-analysis",
      "name": "Parse Trend Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
