{
  "name": "r0merch \u2014 Pinterest Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.pinterest.com/v5/search/pins",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.niche + ' t-shirt design' }}"
            },
            {
              "name": "page_size",
              "value": "25"
            },
            {
              "name": "ad_account_id",
              "value": ""
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "pinterest-fetch",
      "name": "Pinterest API Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        150
      ]
    },
    {
      "parameters": {
        "url": "https://api.pinterest.com/v5/trends/keywords/{{ encodeURIComponent($json.niche + ' t-shirt') }}/trending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}"
            }
          ]
        }
      },
      "id": "pinterest-trends-fetch",
      "name": "Pinterest Trending Keywords",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst pinsRaw    = $('Pinterest API Search').first().json;\nconst trendsRaw  = $('Pinterest Trending Keywords').first().json;\n\nconst pins = (pinsRaw?.items || []).map(pin => ({\n  title:       pin.title || '',\n  description: (pin.description || '').slice(0, 200),\n  url:         pin.link  || `https://www.pinterest.com/pin/${pin.id}`,\n  image:       pin.media?.images?.['600x']?.url || '',\n  saves:       pin.save_count  || 0,\n  clicks:      pin.click_count || 0,\n  dominantColor: pin.dominant_color || ''\n}));\n\nconst trendingKeywords = (trendsRaw?.keywords || []).map(k => k.keyword || k);\n\nconst data = { pins, trendingKeywords };\n\nreturn [{ json: { source: 'pinterest', niche, data } }];"
      },
      "id": "parse-pinterest",
      "name": "Parse Pinterest Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Pinterest API Search",
