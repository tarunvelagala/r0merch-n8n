      },
      "id": "serpapi-trending",
      "name": "SerpAPI Pinterest Trending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst pinsRaw     = $('SerpAPI Pinterest Pins').first().json;\nconst trendingRaw = $('SerpAPI Pinterest Trending').first().json;\n\nconst mapPin = p => ({\n  title:       p.title || '',\n  description: (p.description || '').slice(0, 200),\n  url:         p.link  || '',\n  image:       p.images?.orig?.url || p.images?.['236x']?.url || p.thumbnail || ''\n});\n\nconst pins     = (pinsRaw?.pins_results     || []).map(mapPin);\nconst trending = (trendingRaw?.pins_results || []).map(mapPin);\n\nconst trendingKeywords = [\n  ...(pinsRaw?.related_keywords     || []),\n  ...(trendingRaw?.related_keywords || []),\n  ...(pinsRaw?.refinements          || []),\n  ...(trendingRaw?.refinements      || [])\n].filter(Boolean).slice(0, 20);\n\nconst data = {\n  pins: [...pins, ...trending].slice(0, 30),\n  trendingKeywords\n};\n\nreturn [{ json: { source: 'pinterest', niche, data } }];"
      },
      "id": "parse-pinterest",
      "name": "Parse Pinterest Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    }
