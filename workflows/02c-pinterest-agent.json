      "id": "serpapi-trending",
      "name": "SerpAPI Trending Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst imagesRaw  = $('SerpAPI Google Images').first().json;\nconst trendRaw   = $('SerpAPI Trending Images').first().json;\n\nconst mapResult = r => ({\n  title:       r.title || '',\n  url:         r.link  || r.original || '',\n  image:       r.original || r.thumbnail || '',\n  source:      r.source || '',\n  snippet:     r.snippet || ''\n});\n\nconst pins     = (imagesRaw?.images_results || []).map(mapResult).slice(0, 20);\nconst trending = (trendRaw?.images_results  || []).map(mapResult).slice(0, 10);\n\nconst trendingKeywords = [\n  ...(imagesRaw?.suggested_searches || []).map(s => s.name || s.q || s).filter(Boolean),\n  ...(trendRaw?.suggested_searches  || []).map(s => s.name || s.q || s).filter(Boolean)\n].slice(0, 20);\n\nconst data = {\n  pins: [...pins, ...trending],\n  trendingKeywords\n};\n\nreturn [{ json: { source: 'pinterest', niche, data } }];"
      },
      "id": "parse-results",
      "name": "Parse Pinterest Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
