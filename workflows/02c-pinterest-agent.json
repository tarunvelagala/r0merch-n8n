      "id": "pinterest-trends-fetch",
      "name": "Pinterest Trending Keywords",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst pinsRaw   = $('Pinterest API Search').first().json;\nconst serpRaw   = $('Pinterest Trending Keywords').first().json;\n\n// Pinterest API v5 /search/pins response\nconst pins = (pinsRaw?.items || []).map(pin => ({\n  title:         pin.title || '',\n  description:   (pin.description || '').slice(0, 200),\n  url:           pin.link || `https://www.pinterest.com/pin/${pin.id}`,\n  image:         pin.media?.images?.['600x']?.url || '',\n  saves:         pin.save_count  || 0,\n  clicks:        pin.click_count || 0,\n  dominantColor: pin.dominant_color || ''\n}));\n\n// SerpAPI pinterest engine response\nconst serpPins = (serpRaw?.pins_results || []).map(p => ({\n  title:       p.title || '',\n  description: (p.description || '').slice(0, 200),\n  url:         p.link  || '',\n  image:       p.images?.orig?.url || p.images?.['236x']?.url || ''\n}));\n\nconst trendingKeywords = [\n  ...(serpRaw?.related_keywords || []),\n  ...(serpRaw?.refinements || [])\n].filter(Boolean).slice(0, 20);\n\nconst data = {\n  pins: [...pins, ...serpPins].slice(0, 30),\n  trendingKeywords\n};\n\nreturn [{ json: { source: 'pinterest', niche, data } }];"
      },
      "id": "parse-pinterest",
      "name": "Parse Pinterest Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
