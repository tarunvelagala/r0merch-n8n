      "name": "SerpAPI Trending Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst ir = (() => { try { return $('SerpAPI Google Images').first()?.json || {}; } catch(_) { return {}; } })();\nconst trendRaw = (() => { try { return $('SerpAPI Trending Images').first()?.json || {}; } catch(_) { return {}; } })();\n\n// CSE image results are in 'items'\nconst mapItem = r => ({\n  title: r.title || '',\n  url:   r.link  || r.image?.contextLink || '',\n  image: r.link  || '',\n  source: r.displayLink || ''\n});\n\nconst pins = (ir?.items || []).map(mapItem).slice(0, 20);\nconst trending = (trendRaw?.items || []).map(mapItem).slice(0, 10);\n\nconst trendingKeywords = [\n  ...(ir?.queries?.nextPage || []).map(q => q.searchTerms).filter(Boolean),\n  ...(ir?.items || []).map(r => r.title).filter(Boolean).slice(0,5)\n].slice(0, 20);\n\nreturn [{ json: { source: 'pinterest', niche, data: { pins: [...pins,...trending], trendingKeywords } } }];"
      },
      "id": "parse-results",
      "name": "Parse Pinterest Results",
      "type": "n8n-nodes-base.code",
