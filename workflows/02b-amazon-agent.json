{
  "name": "r0merch — Amazon Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "https://serpapi.com/search.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "engine",   "value": "amazon" },
            { "name": "k",        "value": "={{ $json.niche + ' t-shirt' }}" },
            { "name": "amazon_domain", "value": "amazon.com" },
            { "name": "api_key",  "value": "={{ $vars.SERPAPI_KEY }}" },
            { "name": "department", "value": "fashion-mens-graphic-tees" }
          ]
        }
      },
      "id": "amazon-fetch",
      "name": "SerpAPI Amazon Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst results = $input.first().json?.organic_results || [];\n\nconst data = results.map(item => ({\n  title:   item.title || '',\n  url:     item.link  || `https://www.amazon.com/dp/${item.asin}`,\n  price:   item.price?.raw || item.price || '',\n  image:   item.thumbnail || '',\n  rating:  item.rating || 0,\n  reviews: item.reviews?.total || item.ratings_total || 0,\n  asin:    item.asin || '',\n  bsr:     item.bestseller_rank || null\n}));\n\nreturn [{ json: { source: 'amazon', niche, data } }];"
      },
      "id": "parse-amazon",
      "name": "Parse Amazon Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "SerpAPI Amazon Search",  "type": "main", "index": 0 }]] },
    "SerpAPI Amazon Search":    { "main": [[{ "node": "Parse Amazon Results",   "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["pod", "research", "amazon", "r0merch"]
}
