  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/customsearch/v1",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GOOGLE_API_KEY }}"
            },
            {
              "name": "cx",
              "value": "={{ $env.GOOGLE_CSE_ID }}"
            },
            {
              "name": "q",
              "value": "={{ 'site:amazon.com/dp ' + $json.niche + ' t-shirt best selling graphic tee' }}"
            },
            {
              "name": "num",
              "value": "10"
            },
            {
              "name": "gl",
              "value": "us"
            },
            {
              "name": "hl",
              "value": "en"
            }
          ]
        },
        "options": {
          "timeout": 25000
        }
      },
      "id": "amazon-google-search",
      "name": "Amazon via Google",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst raw = $('Amazon via Google').first()?.json || {};\nconst results = (raw?.items || []).filter(r => r.link?.includes || r.formattedUrl?.includes('amazon.com'));\nconst data = results.map(r => ({\n  title:   r.title   || '',\n  url:     r.link    || '',\n  price:   '',\n  image:   r.thumbnail || '',\n  rating:  0,\n  reviews: 0,\n  asin:    (r.link || '').match(/\\/dp\\/([A-Z0-9]{10})/)?.[1] || '',\n  snippet: r.snippet || ''\n}));\nreturn [{ json: { source: 'amazon', niche, data } }];"
      },
      "id": "parse-amazon",
      "name": "Parse Amazon Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    }
  ],
