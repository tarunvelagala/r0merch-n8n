        {
            "parameters": {
                "jsCode": "  const safe = (nodeName, fallback) => {\n    try { return $(nodeName).first().json || fallback; } catch(_) { return fallback; }\n  };\n\n  const niche = safe('Get row(s)', {}).niche || '';\n  const typoData = safe('Call POD Typography Analyzer Agent', {});\n  const stickerData = safe('Call POD Stickers Inspiration Agent', {});\n  const artworkData = safe('Call POD Artwork Generator Agent', {});\n\n  return [{ json: {\n    niche,\n    typography: typoData.typography || {},\n    slogans:    typoData.slogans    || [],\n    stickers:   stickerData.stickers || {},\n    artwork:    artworkData.artwork  || {},\n  } }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
