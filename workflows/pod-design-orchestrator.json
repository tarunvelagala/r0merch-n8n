                -640
            ],
            "id": "d5eb941e-7f5b-4e8e-aaf6-ac638ed2fa0c",
            "name": "Split Out1"
        },
        {
            "parameters": {
                "jsCode": "const slogan           = $json.slogan              || '';\nconst illustration     = $json.illustrationConcept || '';\nconst placement        = $json.placement           || 'centered chest';\nconst mood             = $json.mood                || '';\nconst niche            = $('Merge Final Ouput').first().json.niche || '';\n\nconst artwork  = $('Merge Final Ouput').first().json.artwork  || {};\nconst stickers = $('Merge Final Ouput').first().json.stickers || {};\nconst typography = $('Merge Final Ouput').first().json.typography || {};\n\n// Art style signals\nconst artStyle   = artwork.illustrationStyle || 'bold graphic illustration';\nconst colorMood  = artwork.colorMood         || 'vibrant high contrast';\nconst composition = artwork.composition      || 'centered graphic';\n\n// Color palette from stickers\nconst colors = (stickers.concepts?.[0]?.colors || []).slice(0, 3).join(', ');\n\n// Icon elements from stickers\nconst icons = (stickers.concepts?.[0]?.icons || []).slice(0, 2).join(', ');\n\n// Typography style\nconst fontStyle = typography.dominantFontStyle || 'bold sans-serif';\nconst letteringMood = typography.letteringMood || '';\n\n// Build prompt\nconst parts = [\n  'POD t-shirt graphic design',\n  '\"' + slogan + '\"',\n  illustration,\n  artStyle,\n  colorMood,\n  composition,\n  colors ? 'color palette: ' + colors : '',\n  icons ? 'include elements: ' + icons : '',\n  'typography: ' + fontStyle + (letteringMood ? ', ' + letteringMood : ''),\n  placement,\n  mood,\n  'transparent background, alpha channel',\n  'bold flat vector illustration, screen print style',\n  '3-5 spot colors max, no gradients, no shadows',\n  'high contrast, print-ready, professional POD design',\n  'centered composition, clean edges',\n].filter(Boolean).join(', ');\n\nreturn [{ json: { ...$json, niche, imagePrompt: parts } }];"
            },
