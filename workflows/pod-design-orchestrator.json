            "parameters": {
                "jsCode": "const raw = $input.first().json?.data ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n\nif (text.includes('event: error')) {\n  return [{ json: { finalImageUrl: $('Parse Ideogram Result').first().json.ideogramImageUrl, enhanced: false } }];\n}\n\nconst match = text.match(/data: (\\[.*\\])/s);\nlet imageUrl = '';\ntry {\n  const parsed = JSON.parse(match?.[1] || '[]');\n  imageUrl = parsed?.[0]?.url || '';\n} catch(_) {}\n\nreturn [{ json: { finalImageUrl: imageUrl, enhanced: !!imageUrl } }];"
