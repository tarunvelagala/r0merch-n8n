        {
            "parameters": {
                "jsCode": "const raw = $input.first().json?.data ?? $input.first().json ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n\n// Detect quota/error\nconst isError = text.includes('event: error') || text.includes('quota exceeded') || text.includes('\"error\"');\nif (isError) {\n  return [{ json: {ideogramImageUrl: '', ideogramCaption: '', usesFallback: true } }];\n}\n\n// Parse success\nconst match = text.match(/data: (\\[.*\\])/s);\nlet imageUrl = '', caption = '';\ntry {\n  const parsed = JSON.parse(match?.[1] || '[]');\n  imageUrl = parsed?.[0]?.url || '';\n  caption  = JSON.stringify(parsed?.[2] || {});\n} catch(_) {}\n\nreturn [{ json: { ideogramImageUrl: imageUrl, ideogramCaption: caption, usesFallback: !imageUrl } }];"
            },
