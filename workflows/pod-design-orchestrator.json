            "parameters": {
                "jsCode": "const item = $input.first();\n// Build the Pollinations URL so Enhance Submit can reference it\nconst prompt = $('Build Image Prompt').first().json.imagePrompt || '';\nconst pollinationsUrl = 'https://image.pollinations.ai/prompt/' + encodeURIComponent(prompt + ', isolated on pure white background, bold flat vector illustration, screen print style, 3-5 spot colors max, no gradients, no shadows, no textures, high contrast, print-ready t-shirt graphic, centered composition, professional POD design') + '?width=1024&height=1024&nologo=true&model=flux&enhance=true';\nreturn [{ json: { ...item.json, pollinationsUrl }, binary: item.binary || {} }];"
