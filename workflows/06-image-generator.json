  "id": "a7e13a5f-b228-40c9-b37a-c91545985814",
  "name": "r0merch \u2014 Image Generator",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed;\ntry {\n  parsed = typeof raw.concepts === 'string' ? JSON.parse(raw.concepts) : raw;\n} catch (_) { parsed = raw; }\nconst concepts = parsed.concepts || [];\nconst niche    = parsed.niche || '';\nreturn concepts.map(c => ({ json: { niche, ...c } }));"
      },
      "id": "split-concepts",
      "name": "Split Into Concepts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/imagen-3.0-generate-002:predict",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  instances: [{\n    prompt: $json.imagePrompt + '. T-shirt graphic design, transparent background, clean bold vector art, print-ready, high contrast, no photorealism, flat illustration.'\n  }],\n  parameters: {\n    sampleCount: 1,\n    aspectRatio: \"1:1\",\n    safetyFilterLevel: \"block_few\",\n    personGeneration: \"allow_adult\"\n  }\n}) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "gemini-imagen",
      "name": "Gemini Imagen 3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        150
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const geminiResult = $input.first();\nconst ctx = $('Split Into Concepts').first().json;\n// Gemini Imagen returns base64 in predictions[0].bytesBase64Encoded\nconst b64 = geminiResult.json?.predictions?.[0]?.bytesBase64Encoded;\nif (b64) {\n  return [{ json: { ...ctx, imageBase64: b64, imageUrl: '', provider: 'gemini', success: true } }];\n}\n// Failed \u2014 pass to Ideogram fallback\nreturn [{ json: { ...ctx, imageBase64: '', imageUrl: '', provider: '', success: false } }];"
      },
      "id": "check-gemini",
      "name": "Check Gemini Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "route-success",
      "name": "Gemini Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://multimodalart-ideogram4.hf.space/gradio_api/call/infer",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.HF_TOKEN ? \"Bearer \" + $env.HF_TOKEN : \"\" }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  data: [\n    $json.imagePrompt + '. T-shirt graphic, transparent background, bold flat vector illustration, print-ready, high contrast.',\n    \"None\",\n    1024,\n    1024,\n    3\n  ]\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "ideogram-submit",
      "name": "Ideogram Submit Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ \"https://multimodalart-ideogram4.hf.space/gradio_api/call/infer/\" + $json.event_id }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "ideogram-poll",
      "name": "Ideogram Poll Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Split Into Concepts').first().json;\nconst raw = $input.first().json;\n// Gradio returns {data: [[{url: '...'}]]} or similar\nconst imgUrl = raw?.data?.[0]?.[0]?.url || raw?.data?.[0]?.url || raw?.data?.[0] || '';\nreturn [{ json: { ...ctx, imageBase64: '', imageUrl: imgUrl, provider: 'ideogram', success: !!imgUrl } }];"
      },
      "id": "parse-ideogram",
      "name": "Parse Ideogram Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst niche    = item.niche    || 'unknown';\nconst id       = item.id       || Date.now();\nconst ts       = new Date().toISOString().replace(/[:.]/g, '-');\nconst fileName = `design_${niche}_${id}_${ts}.png`;\n\nreturn [{\n  json: {\n    niche,\n    conceptId:      id,\n    title:          item.title          || '',\n    phrase:         item.phrase         || '',\n    tone:           item.tone           || '',\n    source:         item.source         || '',\n    targetAudience: item.targetAudience || '',\n    sellingAngle:   item.sellingAngle   || '',\n    imagePrompt:    item.imagePrompt    || '',\n    imageUrl:       item.imageUrl       || '',\n    imageBase64:    item.imageBase64    || '',\n    provider:       item.provider       || '',\n    fileName,\n    generatedAt:    new Date().toISOString()\n  }\n}];"
      },
      "id": "prepare-record",
      "name": "Prepare PNG Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        250
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{ json: { designs: items.map(i => i.json) } }];"
      },
      "id": "collect-designs",
      "name": "Collect All Designs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        250
      ]
    }
  ],
