      "parameters": {}
    },
    {
      "id": "check-cse-02f-google-trends-agent",
      "name": "CSE Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.items || $json.organic_results || $json.shopping_results || []).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
