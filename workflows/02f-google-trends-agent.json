    {
      "parameters": {
        "url": "https://serpapi.com/search.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "engine",
              "value": "google_trends"
            },
            {
              "name": "q",
              "value": "={{ $json.niche + ' t-shirt' }}"
            },
            {
              "name": "api_key",
              "value": "={{ $env.SERPAPI_KEY }}"
            },
            {
              "name": "data_type",
              "value": "RELATED_QUERIES"
            },
            {
              "name": "date",
              "value": "today 12-m"
            },
            {
              "name": "geo",
              "value": "US"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "trends-related-fetch",
      "name": "SerpAPI Related Queries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst tr = (() => { try { return $('SerpAPI Timeseries').first()?.json || {}; } catch(_) { return {}; } })();\nconst rr = (() => { try { return $('SerpAPI Related Queries').first()?.json || {}; } catch(_) { return {}; } })();\n\n// CSE doesn't have timeseries \u2014 extract trend signals from search results\nconst items = (tr?.items || []);\nconst relatedItems = (rr?.items || []);\n\n// Extract trending queries from titles and snippets\nconst allText = [...items, ...relatedItems].map(r => r.title + ' ' + (r.snippet || '')).join(' ');\nconst risingQueries = items.slice(0, 5).map(r => r.title).filter(Boolean);\nconst topQueries = [...items, ...relatedItems].slice(0, 8).map(r =>\n  (r.title || '').replace(/t-shirt|tshirt|shirt/gi, '').trim()\n).filter(Boolean);\n\n// Detect trend direction from recency of results\nconst trendDirection = items.length > 5 ? 'rising' : 'stable';\n\nreturn [{ json: { source: 'google_trends', niche, data: {\n  timeline: [],\n  trendDirection,\n  peakMonths: [],\n  lowMonths: [],\n  risingQueries,\n  topQueries\n} } }];"
      },
      "id": "parse-trends",
      "name": "Parse Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "id": "skip-error",
      "name": "Skip Error",
      "type": "n8n-nodes-base.noOp",
