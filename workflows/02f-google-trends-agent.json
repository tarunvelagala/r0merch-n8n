    },
    {
      "id": "merge-cse-serp-02f-google-trends-agent",
      "name": "Merge CSE/SerpAPI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "jsCode": "// Accept data from either CSE success path or SerpAPI fallback\nconst item = $input.first()?.json || {};\n\n// Normalize SerpAPI formats to CSE 'items' format\nconst normalized = { ...item };\nif (!normalized.items) {\n  if (normalized.organic_results?.length) {\n    normalized.items = normalized.organic_results.map(r => ({\n      title: r.title, link: r.link, snippet: r.snippet,\n      displayLink: r.source || new URL(r.link || 'https://x.com').hostname\n    }));\n  } else if (normalized.shopping_results?.length) {\n    normalized.items = normalized.shopping_results.map(r => ({\n      title: r.title, link: r.link, snippet: r.snippet || ''\n    }));\n  } else if (normalized.interest_over_time) {\n    // Google Trends \u2014 keep as-is\n    normalized.items = [];\n  } else {\n    normalized.items = [];\n  }\n}\nreturn [{ json: normalized }];"
      }
    }
  ],
