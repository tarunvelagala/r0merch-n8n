    },
    {
      "id": "merge-cse-serp-02f-google-trends-agent",
      "name": "Merge CSE/SerpAPI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "jsCode": "// Use whichever result has data \u2014 CSE or SerpAPI fallback\nconst item = $input.first().json;\n// Normalize: map SerpAPI organic_results to items if needed\nif (!item.items && item.organic_results) {\n  item.items = item.organic_results.map(r => ({ title: r.title, link: r.link, snippet: r.snippet, displayLink: r.source }));\n}\nif (!item.items && item.shopping_results) {\n  item.items = item.shopping_results.map(r => ({ title: r.title, link: r.link, snippet: r.snippet }));\n}\nreturn [{ json: item }];"
      }
    }
