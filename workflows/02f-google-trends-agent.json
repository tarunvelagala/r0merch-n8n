      },
      "id": "trends-related-fetch",
      "name": "SerpAPI Related Queries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst tr = (() => { try { return $('SerpAPI Timeseries').first()?.json || {}; } catch(_) { return {}; } })();\nconst rr = (() => { try { return $('SerpAPI Related Queries').first()?.json || {}; } catch(_) { return {}; } })();\nconst timeline = (tr?.interest_over_time?.timeline_data||tr?.items||[]).map(t=>({date:t.date||'',value:t.values?.[0]?.extracted_value??0}));\nconst avg = arr => arr.length?arr.reduce((s,v)=>s+v,0)/arr.length:0;\nconst r4=avg(timeline.slice(-4).map(t=>t.value)),p4=avg(timeline.slice(-8,-4).map(t=>t.value));\nconst trendDirection=r4>p4*1.1?'rising':r4<p4*0.9?'falling':'stable';\nconst rising=(rr?.related_queries?.rising||[]).map(r=>r.query);\nconst top=(rr?.related_queries?.top||[]).map(r=>r.query);\nreturn [{json:{source:'google_trends',niche,data:{timeline,trendDirection,peakMonths:[],lowMonths:[],risingQueries:rising.length?rising:top.slice(0,5),topQueries:top}}}];"
      },
      "id": "parse-trends",
      "name": "Parse Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "id": "skip-error",
      "name": "Skip Error",
      "type": "n8n-nodes-base.noOp",
