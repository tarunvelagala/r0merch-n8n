      "id": "trends-related-fetch",
      "name": "SerpAPI Related Queries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst raw = (() => { try { return $('Google Trends Rising').first()?.json || {}; } catch(_) { return {}; } })();\n\n// Extract rising and top related queries \u2014 these are the actionable signals\nconst rising = (raw?.related_queries?.rising || []).slice(0, 10).map(r => r.query).filter(Boolean);\nconst top    = (raw?.related_queries?.top    || []).slice(0, 10).map(r => r.query).filter(Boolean);\n\n// Trend direction from rising count\nconst trendDirection = rising.length > 5 ? 'rising' : rising.length > 2 ? 'stable' : 'stable';\n\nreturn [{ json: { source: 'google_trends', niche, data: {\n  timeline:       [],        // removed \u2014 not useful for POD\n  trendDirection,\n  peakMonths:     [],        // removed \u2014 not actionable\n  lowMonths:      [],\n  risingQueries:  rising,\n  topQueries:     top\n} } }];"
      },
      "id": "parse-trends",
      "name": "Parse Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "id": "skip-error",
      "name": "Skip Error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        900,
        600
      ],
      "parameters": {}
    },
    {
      "id": "check-cse-02f-google-trends-agent",
      "name": "CSE Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ (() => { const j=$json; return (j.related_queries?.rising||j.related_queries?.top||[]).length > 0 || (j.items||[]).length > 0; })() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "serp-fallback-02f-google-trends-agent",
