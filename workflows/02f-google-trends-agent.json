    {
      "id": "check-cse-02f-google-trends-agent",
      "name": "CSE Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ (() => { const j = $json; const items = j.items || j.organic_results || j.shopping_results || j.interest_over_time?.timeline_data || []; return items.length > 0 && !j.error; })() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
