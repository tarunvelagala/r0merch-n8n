    {
      "parameters": {
        "jsCode": "const niche = $('Unpack Input').first().json.niche || '';\n\nconst safe = (nodeName, def) => {\n  try {\n    const items = $(nodeName).all();\n    const found = items.find(i => i.json?.source || i.json?.data);\n    if (!found) return def;\n    return found.json.data ?? def;\n  } catch(_) { return def; }\n};\n\n// Strip any error fields that leaked in\nconst cleanData = (d) => { if (Array.isArray(d)) return d.map(i => { const c={...i}; delete c.error; return c; }); if (d && typeof d === 'object') { const c={...d}; delete c.error; return c; } return d; };\n\nreturn [{ json: {\n  niche,\n  etsy:         [],\n  amazon:       [],\n  pinterest:    { pins:[], trendingKeywords:[] },\n  reddit:       [],\n  googleSearch: safe('Google Search Agent',  { organic:[], relatedSearches:[], peopleAlsoAsk:[] }),\n  googleTrends: safe('Google Trends Agent',  { timeline:[], trendDirection:'stable', risingQueries:[], topQueries:[] }),\n  vision:       [],\n  twitter:      safe('Twitter Agent',        {}),\n  stickers:     safe('Sticker Trends Agent', { colors:[], styles:[], iconThemes:[], originalConcepts:[] }),\n  collectedAt:  new Date().toISOString()\n} }];"
      },
