      "id": "twitter-viral-fetch",
      "name": "SerpAPI Twitter Viral",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        450
      ],
      "onError": "continueErrorOutput",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Execute Workflow Trigger').first().json.niche;\nconst tr = $('SerpAPI Twitter Search').first()?.json || {};\nconst vr = (() => { try { return $('SerpAPI Twitter Viral').first()?.json || {}; } catch(_) { return {}; } })();\nconst snippets = [...(tr?.organic_results||[]),...(vr?.organic_results||[])].map(r=>r.title+' '+(r.snippet||'')).join('\\n');\nreturn [{json:{niche,rawSnippets:snippets}}];"
      },
      "id": "collect-snippets",
      "name": "Collect Tweet Snippets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.1-8b-instant', messages: [{ role: 'user', content: 'You are a trend analyst for print-on-demand merchandise.\\n\\nHere are recent tweets and posts from Twitter/X about the \"' + $json.niche + '\" niche:\\n\\n' + $json.rawSnippets + '\\n\\nExtract trending signals useful for t-shirt design. Return ONLY a raw JSON object, no markdown, no code fences.\\nShape:\\n{\\n  \"trendingPhrases\": [],\\n  \"slang\": [],\\n  \"hashtags\": [],\\n  \"memes\": [],\\n  \"culturalSignals\": [],\\n  \"emotions\": [],\\n  \"keywords\": []\\n}' }], max_tokens: 600, temperature: 0.4 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "groq-analyze",
      "name": "Groq Trend Analyzer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const niche = $('Collect Tweet Snippets').first().json.niche;\nconst raw = $input.first().json?.choices?.[0]?.message?.content || '{}';\nconst clean = raw.replace(/```json|```/g, '').trim();\nconst match = clean.match(/\\{[\\s\\S]*\\}/);\nlet analysis = {};\ntry { analysis = JSON.parse(match?.[0] || '{}'); } catch(_) {}\n\nreturn [{ json: { source: 'twitter', niche, data: analysis } }];"
      },
      "id": "parse-twitter",
      "name": "Parse Twitter Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
