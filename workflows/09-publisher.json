  "id": "8770f81f-e7ce-469e-a60b-410df33f951f",
  "name": "r0merch — Publisher (Optional)",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-input",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed;\ntry {\n  parsed = typeof raw.listings === 'string' ? JSON.parse(raw.listings) : raw;\n} catch (_) { parsed = raw; }\n\nconst listings = parsed.listings || (Array.isArray(parsed) ? parsed : [parsed]);\nreturn listings.map(l => ({ json: l }));"
      },
      "id": "split-listings",
      "name": "Split Listings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openapi.etsy.com/v3/application/shops/{{ $env.ETSY_SHOP_ID }}/listings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ETSY_API_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.ETSY_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  quantity: 999,\n  title: $json.etsyTitle,\n  description: $json.etsyDescription,\n  price: 24.99,\n  who_made: 'i_did',\n  when_made: 'made_to_order',\n  taxonomy_id: 1103,\n  tags: ($json.etsyTags || []).slice(0, 13),\n  type: 'physical',\n  shipping_profile_id: $env.ETSY_SHIPPING_PROFILE_ID\n}) }}"
      },
      "id": "etsy-create-listing",
      "name": "Etsy: Create Listing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        150
      ],
      "disabled": true,
      "notes": "Set ETSY_SHOP_ID, ETSY_API_KEY, ETSY_ACCESS_TOKEN, ETSY_SHIPPING_PROFILE_ID in n8n Variables"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sellingpartnerapi-na.amazon.com/listings/2021-08-01/items/{{ $env.AMAZON_SELLER_ID }}/{{ $json.seoFileName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-amz-access-token",
              "value": "={{ $env.AMAZON_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  productType: 'SHIRT',\n  requirements: 'LISTING',\n  attributes: {\n    item_name:            [{ value: $json.amazonTitle,              language_tag: 'en_US' }],\n    bullet_point:         ($json.amazonBulletPoints || []).map(b => ({ value: b, language_tag: 'en_US' })),\n    generic_keyword:      [{ value: $json.amazonKeywords,           language_tag: 'en_US' }],\n    condition_type:       [{ value: 'new_new' }]\n  }\n}) }}"
      },
      "id": "amazon-create-listing",
      "name": "Amazon: Create Listing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        450
      ],
      "disabled": true,
      "notes": "Set AMAZON_SELLER_ID, AMAZON_ACCESS_TOKEN in n8n Variables. Uses SP-API."
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Split Listings",
            "type": "main",
            "index": 0
          }
